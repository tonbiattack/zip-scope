// Resources for the ZipScope shell extension.
//
// The icon is the same artwork the application uses, so the extension is
// recognisable in Explorer's handler list and in the DLL's file properties.

#include <windows.h>

// The icon file is generated by scripts/make-icon.ps1.
1 ICON "..\\build\\windows\\icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "tonbiattack"
            VALUE "FileDescription",  "ZipScope Explorer integration"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "ZipScopeShell"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "ZipScopeShell.dll"
            VALUE "ProductName",      "ZipScope"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
