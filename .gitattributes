# Batch files must keep CRLF line endings: cmd.exe mis-parses LF-only scripts,
# which silently breaks variable expansion and multi-line commands.
*.cmd text eol=crlf
*.bat text eol=crlf

# Everything else uses LF in the repository.
*.go text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.def text eol=lf

# Binary assets are never converted.
*.png binary
*.ico binary
*.exe binary
*.dll binary
